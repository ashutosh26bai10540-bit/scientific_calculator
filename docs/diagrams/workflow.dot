digraph G { rankdir=TB; node [shape=box, style=rounded]; Start [shape=oval,label="Start"]; Menu [label="Display menu"]; Choice [shape=diamond,label="Choice = 12?"]; Exit [label="Print thank-you\nExit"]; Valid [shape=diamond,label="Valid operation?"]; Input [label="Read required number(s)"]; Calc [label="Dispatch to operation"]; Result [label="Display result"]; Error [label="Display validation/error message"]; Again [label="Read next choice"]; Start->Menu->Choice; Choice->Exit [label="Yes"]; Choice->Valid [label="No"]; Valid->Input [label="Yes"]; Valid->Error [label="No"]; Input->Calc->Result->Again->Choice; Error->Again; }
