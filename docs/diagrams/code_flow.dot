digraph G { rankdir=TB; node [shape=box, style=rounded]; A [shape=oval,label="Start program"]; B [label="Display calculator menu"]; C [label="Read choice"]; D [shape=diamond,label="Exit? (12)"]; E [label="Read input values"]; F [label="Validate/convert input"]; G [label="Select operation\nvia calculator.py"]; H [label="Run arithmetic/scientific function"]; I [label="Print result"]; J [label="Handle ValueError / ZeroDivisionError"];
A->B->C->D; D->J [label="No + invalid?",style=dashed]; D->E [label="No"]; D->K [label="Yes"]; K [shape=oval,label="End"]; E->F->G->H->I->C; F->J [label="Invalid input"]; G->J [label="Invalid/unsupported",style=dashed]; J->C; }
