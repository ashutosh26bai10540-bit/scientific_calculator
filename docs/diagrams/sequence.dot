digraph G { rankdir=LR; node [shape=box, style=rounded]; U [label="User"]; UI [label="ui.py"]; V [label="validators.py"]; C [label="calculator.py"]; O [label="operation module"]; U->UI [label="choose + enter values"]; UI->V [label="parse input"]; V->UI [label="numeric value"]; UI->C [label="dispatch(choice, values)"]; C->O [label="execute function"]; O->C [label="result / error"]; C->UI [label="return result"]; UI->U [label="display result"]; }
