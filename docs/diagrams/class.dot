digraph G { rankdir=LR; node [shape=record]; Main [label="{main.py|+ run()}"]; UI [label="{ui.py|+ run()}"]; Calc [label="{calculator.py|+ calculate_choice()}"]; Ops [label="{operations.py|+ add()\l+ subtract()\l+ multiply()\l+ divide()\l+ power()\l+ square()\l}"]; Sci [label="{scientific.py|+ square_root()\l+ factorial()\l+ sin_degrees()\l+ cos_degrees()\l+ tan_degrees()\l}"]; Val [label="{validators.py|+ parse_float()\l+ parse_integer()\l}"]; Menu [label="{menu.py|+ display_menu()\l+ MENU}"]; Main->UI; UI->Calc; UI->Val; UI->Menu; Calc->Ops; Calc->Sci; }
